#!/bin/sh
# Pre-commit hook — kiểm tra cú pháp Python trước khi commit
# Cài đặt (chạy 1 lần sau khi clone):  git config core.hooksPath .githooks

files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')
[ -z "$files" ] && exit 0

PY=$(command -v python || command -v python3)
if [ -z "$PY" ]; then
  echo "pre-commit: không tìm thấy Python, bỏ qua kiểm tra." >&2
  exit 0
fi

fail=0
for f in $files; do
  # Kiểm tra đúng nội dung đã staged (git show :file), không ghi file .pyc
  if ! git show ":$f" | "$PY" -c "import sys; compile(sys.stdin.buffer.read(), sys.argv[1], 'exec')" "$f"; then
    echo "❌ Lỗi cú pháp Python: $f" >&2
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo "⛔ Commit bị chặn — hãy sửa lỗi cú pháp rồi commit lại." >&2
  exit 1
fi
echo "✅ pre-commit: cú pháp Python hợp lệ ($(echo $files | wc -w) file)"
